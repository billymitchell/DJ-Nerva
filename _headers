# Images/video are referenced with ?v=<mtime> from the manifests, so they can be
# cached for a year. Replace a file -> rebuild the manifest -> new URL.
/splash-images/*
  Cache-Control: public, max-age=31536000, immutable

/DJ-images/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/og-image.jpg
  Cache-Control: public, max-age=604800

# CSS/JS are stamped with a content hash by scripts/bump_asset_versions.js.
# A day of caching plus background revalidation keeps repeat visits instant
# without risking a week-old script if a bump is forgotten.
/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.json
  Cache-Control: public, max-age=0, must-revalidate

# Security headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
